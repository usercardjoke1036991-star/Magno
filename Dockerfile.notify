FROM node:20-alpine
WORKDIR /app
COPY scripts/notify-worker.mjs scripts/bscNetworks.cjs scripts/textbeltSms.cjs scripts/telegramBotName.cjs scripts/notify-entrypoint.sh scripts/attest2of2.mjs scripts/adminTotp.mjs ./scripts/
# node:20-alpine quedó en abril de 2026 con zlib 1.3.2-r0. El parche es 1.3.2-r1.
RUN npm init -y \
  && npm pkg set overrides.ws=8.21.0 \
  && npm install ethers@6.15.0 dotenv@16.3.1 --omit=dev --ignore-scripts \
  && apk add --no-cache --upgrade su-exec zlib \
  && if apk list -I zlib | grep -q 'zlib-1.3.2-r0'; then echo "zlib sigue en 1.3.2-r0" >&2; exit 1; fi \
  && mkdir -p /data \
  && chmod +x /app/scripts/notify-entrypoint.sh \
  && chown -R node:node /app /data \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
ENV NODE_ENV=production
ENV NOTIFY_BIND=0.0.0.0
ENV NOTIFY_TRUST_PROXY=1
ENV NOTIFY_DATA_FILE=/data/.notify-data.json
# Render inyecta PORT (suele ser 10000). En local/Fly queda 8787 si no hay PORT.
EXPOSE 8787 10000
# docker:S6471: el usuario declarado es node. Si el runtime arranca como root
# (volumen /data de Render/Hetzner), el entrypoint hace chown y su-exec node.
USER node
ENTRYPOINT ["/app/scripts/notify-entrypoint.sh"]
CMD ["node", "scripts/notify-worker.mjs"]
