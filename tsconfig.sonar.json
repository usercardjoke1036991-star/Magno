{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "i18n/**/*.ts",
    "profile/**/*.ts",
    "profile/**/*.tsx",
    "services/**/*.ts",
    "theme/**/*.ts",
    "theme/**/*.tsx",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules", "android", "ios", "test", "scripts", "contracts"]
}
