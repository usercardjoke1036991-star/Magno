# Copia a .env.worker (está en .gitignore). No uses este archivo para el teléfono.
# Arranque: npm run notify:prod
# El .env local (chain 97) se carga primero; esto pisa solo lo de mainnet.

EXPO_PUBLIC_CHAIN_ID=56
EXPO_PUBLIC_CONTRACT_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org/

NOTIFY_BIND=127.0.0.1
NOTIFY_PORT=8787
NOTIFY_CORS_ORIGIN=https://quatriviumcredit.app
NOTIFY_DATA_KEY=
# En Fly/Render el proceso usa PORT y 0.0.0.0:
# NOTIFY_BIND=0.0.0.0
# NOTIFY_TRUST_PROXY=1
# NOTIFY_DATA_FILE=/data/.notify-data.json

# URL pública HTTPS 24/7 (Fly: https://quatrivium-notify.fly.dev).
EXPO_PUBLIC_NOTIFY_API=https://notify.quatriviumcredit.app

# OTP teléfono: Twilio SMS (SID + token + FROM internacional).
# En cuentas trial Messaging no admite texto propio: el worker usa Verify.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Correo de alta y avisos (Resend). Obligatorio en mainnet.
RESEND_API_KEY=
EMAIL_FROM=soporte@quatriviumcredit.app

# Obligatorio y distinto del owner. Si está vacío, el worker de demo usa PRIVATE_KEY del .env.
ATTESTER_PRIVATE_KEY=
